# Studio Frontend Environment Variables
# Copy to .env and populate from KMS: kms.hanzo.ai

# Firebase Dev Config
# Get from KMS: kms.hanzo.ai/hanzo/studio/firebase-dev-api-key
VITE_FIREBASE_API_KEY=<from-kms>
VITE_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=<project-id>
VITE_FIREBASE_STORAGE_BUCKET=<project-id>.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=<from-kms>
VITE_FIREBASE_APP_ID=<from-kms>
VITE_FIREBASE_MEASUREMENT_ID=<from-kms>

# Firebase Prod Config
# Get from KMS: kms.hanzo.ai/hanzo/studio/firebase-prod-api-key
VITE_FIREBASE_PROD_API_KEY=<from-kms>
VITE_FIREBASE_PROD_AUTH_DOMAIN=<project-id>.firebaseapp.com
VITE_FIREBASE_PROD_DATABASE_URL=https://<project-id>-default-rtdb.firebaseio.com
VITE_FIREBASE_PROD_PROJECT_ID=<project-id>
VITE_FIREBASE_PROD_STORAGE_BUCKET=<project-id>.appspot.com
VITE_FIREBASE_PROD_MESSAGING_SENDER_ID=<from-kms>
VITE_FIREBASE_PROD_APP_ID=<from-kms>
VITE_FIREBASE_PROD_MEASUREMENT_ID=<from-kms>
